<%-include('../cabecalho.ejs')%>
    <h1>Editar Desenvolvedor</h1>
    <div>
        <a href="/desenvolvedr/lst">Listar</a>
    </div>
    <div>
        <form method="post">

            <input type="hidden" name="id" value="<%=Desenvolvedor.id%>"><br>
            <label>Nome:</label>
            <input type="text" name="nome" value="<%=Desenvolvedor.nome%>"><br>
