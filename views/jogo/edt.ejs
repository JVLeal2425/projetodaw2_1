<%-include('../cabecalho.ejs')%>
    <h1>Editar Jogo</h1>
    <div>
        <a href="/jogo/lst">Listar</a>
    </div>
    <div>
        <form method="post" enctype="multipart/form-data">

            <input type="hidden" name="id" value="<%=Jogo.id%>"><br>
            <label>Nome:</label>
            <input type="text" name="nome" value="<%=Jogo.nome%>"><br>
            <label>Ano de Lançamento:</label>
            <input type="number" name="anoLancamento" value="<%=Jogo.anoLancamento%>"><br>
            <label>Tempo Médio de Jogatina:</label>
            <input type="text" name="tempoMedio" value="<%=Jogo.tempoMedio%>"><br>
            <label>Nota do Jogo:</label>
            <input type="number" name="nota" value="<%=Jogo.nota%>"><br>
            <label>Status Do Jogo:</label>
            <input type="text" name="status" value="<%=Jogo.status%>"><br>
            <label>Imagem do Jogo:</label>
            <input type="file" name="imagem" value="<%=Jogo.imagem%>" placeholder="<%=Jogo.imagem%>"><br>
            <label for="genero" class="form-label">Genero</label>
            <select name="genero" id="genero" class="form-control"><br>
                <option value="">Selecione</option>
                <%Generos.forEach(function(genero){%>
                    <option value='<%=genero.id%>'>
                        <%=genero.nome%>
                    </option>
                    <%})%>
            <option value="<%=genero.id%>" <%= (genero.id.toString() === Jogo.genero.toString()) ? 'selected' : '' %>
            ><%=genero.nome%></option>
            </select>
            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%-include('../rodape.ejs')%>