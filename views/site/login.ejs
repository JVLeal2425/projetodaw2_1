<!DOCTYPE html>
<html lang="pt-BR">
<%-include('cabecalho.ejs')%>

  <main id="main-content" role="main">
    <div class="auth-container">
      <div class="auth-tabs" role="tablist" aria-label="Seleção de Acesso">
        <button type="button" class="auth-tab active" id="tab-login" role="tab" aria-selected="true"
          aria-controls="pane-login">Entrar</button>
        <button type="button" class="auth-tab" id="tab-register" role="tab" aria-selected="false"
          aria-controls="pane-register">Cadastrar</button>
      </div>

      <!-- Formulário de Login -->
      <div id="pane-login" role="tabpanel" aria-labelledby="tab-login">
        <form class="auth-form" id="form-login">
          <div class="form-group">
            <label for="login-email">E-mail</label>
            <input type="email" id="login-email" placeholder="seu@email.com" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="login-password">Senha</label>
            <input type="password" id="login-password" placeholder="Digite sua senha" required aria-required="true">
          </div>
          <button type="submit" class="btn-submit">Entrar no Sistema</button>
        </form>
      </div>

      <!-- Formulário de Cadastro -->
      <div id="pane-register" role="tabpanel" aria-labelledby="tab-register" style="display: none;">
        <form class="auth-form" id="form-register">
          <div class="form-group">
            <label for="reg-name">Nome Completo</label>
            <input type="text" id="reg-name" placeholder="Seu Nome" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="reg-email">E-mail</label>
            <input type="email" id="reg-email" placeholder="seu@email.com" required aria-required="true">
          </div>
          <div class="form-group">
            <label for="reg-password">Senha</label>
            <input type="password" id="reg-password" placeholder="Crie uma senha segura" required aria-required="true">
          </div>
          <button type="submit" class="btn-submit">Criar Minha Conta</button>
        </form>
      </div>

      <div id="auth-feedback" class="auth-feedback" aria-live="polite"></div>
    </div>
  </main>

  <%-include('rodape.ejs')%>

    <script src="script.js"></script>
    </body>

</html>