<!DOCTYPE html>
<html lang="pt-BR">

<%-include('cabecalho.ejs')%>

  <main id="main-content" role="main">
    <section aria-labelledby="welcome-title">
      <h1 id="welcome-title">Bem-vindo à Plataforma de Jogos</h1>
      <p>Explore nosso catálogo completo de jogos, desenvolvedores, gêneros e avaliações de usuários.</p>

      <form class="search-bar" role="search" action="jogos.html" method="GET">
        <label for="search-input" style="position:absolute;left:-9999px;">Pesquisar por jogo, gênero ou
          desenvolvedor</label>
        <input type="text" id="search-input" name="q" placeholder="Pesquisar por jogo, gênero ou desenvolvedor...">
        <button type="submit">Pesquisar</button>
      </form>
    </section>

    <section aria-labelledby="featured-title">
      <h2 id="featured-title">Jogos em Destaque</h2>

      <div class="game-grid" id="catalog-grid">
      <article class="game-card">
        <%for (const {id, imagem, nome, genero, desenvolvedor, anoLancamento, tempoMedio, status, nota} of jogos) {%>
          <img src="<%=imagem%>" alt="Uma imagem do jogo :3">
          <div class="game-card-content">
            <h3>
              <%=nome%>
            </h3>
            <p><strong>Gênero:</strong>
              <%=genero !=null ? genero.nome : "" %>
            </p>
            <p><strong>Desenvolvedor:</strong>
              <%=desenvolvedor !=null ? desenvolvedor.nome : "" %>
            </p>
            <p><strong>Ano de Lançamento:</strong>
              <%=anoLancamento%>
            </p>
            <p><strong>Tempo Médio:</strong>
              <%=tempoMedio%>
            </p>
            <p><strong>Status:</strong> <span class="badge badge-active">
                <%=status%>
              </span></p>
            <p class="rating">★ Nota: <%=nota%>
            </p>
            <a href="/site/jogos/<%=id%>" class="card-link" aria-label="Ver mais detalhes sobre o jogo">Ver
              Detalhes</a>
          </div>
          <%}%>
      </article>
    </div>

  <%-include('rodape.ejs')%>

    <script src="script.js"></script>
    </body>

</html>