<!DOCTYPE html>
<html lang="pt-BR">
<%-include('cabecalho.ejs')%>

  <main id="main-content" role="main">
    <article class="game-detail-container">
      <div class="game-detail-header">
        <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=800&q=80"
          alt="Captura detalhada em alta resolução do jogo Cyber Quest mostrando paisagem futurista em neon"
          class="game-detail-img">

        <div class="game-detail-info">
          <h1>Cyber Quest</h1>
          <p><strong>Gênero:</strong> RPG / Sci-Fi</p>
          <p><strong>Desenvolvedor:</strong> Pixel Studio (Categoria: Indie)</p>
          <p><strong>Ano de Lançamento:</strong> 2023</p>
          <p><strong>Tempo Médio de Jogatina:</strong> 45 horas</p>
          <p><strong>Status:</strong> <span class="badge badge-active">Ativo</span></p>
          <p class="rating">★ Média das Avaliações: 8.9 / 10</p>

          <button id="btn-favorite" type="button" class="btn-fav" aria-label="Favoritar o jogo Cyber Quest">
            ❤️ Favoritar Jogo
          </button>
        </div>
      </div>

      <section class="evaluation-section" aria-labelledby="eval-heading">
        <h2 id="eval-heading">Avaliar este Jogo</h2>
        <p>A avaliação é exclusiva para cada usuário e varia de 0 a 10.</p>

        <form class="eval-form" id="form-evaluation">
          <label for="user-rating">Sua Nota (0 a 10):</label>
          <input type="number" id="user-rating" min="0" max="10" step="0.5" placeholder="8.5" required
            aria-required="true">
          <button type="submit">Enviar Avaliação</button>
        </form>
        <p id="eval-feedback" style="margin-top: 0.75rem; color: var(--accent-cyan);" aria-live="polite"></p>
      </section>
    </article>
  </main>

  <%-include('rodape.ejs')%>

    <script src="script.js"></script>
    </body>

</html>