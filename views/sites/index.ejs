<!DOCTYPE html>
<html lang="pt-BR">

<%-include('cabecalho.ejs')%>

  <main id="main-content" role="main">
    <section aria-labelledby="welcome-title">
      <h1 id="welcome-title">Bem-vindo à Plataforma de Jogos</h1>
      <p>Explore nosso catálogo completo de jogos, desenvolvedores, gêneros e avaliações de usuários.</p>

      <form class="search-bar" role="search" action="jogos.html" method="GET">
        <label for="search-input" style="position:absolute;left:-9999px;">Pesquisar por jogo, gênero ou
          desenvolvedor</label>
        <input type="text" id="search-input" name="q" placeholder="Pesquisar por jogo, gênero ou desenvolvedor...">
        <button type="submit">Pesquisar</button>
      </form>
    </section>

    <section aria-labelledby="featured-title">
      <h2 id="featured-title">Jogos em Destaque</h2>

      <div class="game-grid">
        <article class="game-card">
          <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=500&q=80"
            alt="Cena futurista em estilo cyberpunk do jogo Cyber Quest com neon roxo e azul">
          <div class="game-card-content">
            <h3>Cyber Quest</h3>
            <p><strong>Gênero:</strong> RPG / Sci-Fi</p>
            <p><strong>Desenvolvedor:</strong> Pixel Studio</p>
            <p><strong>Status:</strong> <span class="badge badge-active">Ativo</span></p>
            <p class="rating">★ Nota: 8.9 / 10</p>
            <a href="/jogo-detalhes" class="card-link" aria-label="Ver mais detalhes sobre o jogo Cyber Quest">Ver
              Detalhes</a>
          </div>
        </article>

        <article class="game-card">
          <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?w=500&q=80"
            alt="Guerreiros e cenário de fantasia mística do jogo Fantasy Realm">
          <div class="game-card-content">
            <h3>Fantasy Realm</h3>
            <p><strong>Gênero:</strong> Aventura / RPG</p>
            <p><strong>Desenvolvedor:</strong> Dream Games</p>
            <p><strong>Status:</strong> <span class="badge badge-active">Ativo</span></p>
            <p class="rating">★ Nota: 9.4 / 10</p>
            <a href="/jogo/:id" class="card-link" aria-label="Ver mais detalhes sobre o jogo Fantasy Realm">Ver
              Detalhes</a>
          </div>
        </article>

        <article class="game-card">
          <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=500&q=80"
            alt="Nave espacial acelerando em órbita planetária no jogo Space Racer">
          <div class="game-card-content">
            <h3>Space Racer</h3>
            <p><strong>Gênero:</strong> Corrida / Sci-Fi</p>
            <p><strong>Desenvolvedor:</strong> Velocity Works</p>
            <p><strong>Status:</strong> <span class="badge badge-dev">Em Desenvolvimento</span></p>
            <p class="rating">★ Nota: 7.5 / 10</p>
            <a href="/jogo/:id" class="card-link" aria-label="Ver mais detalhes sobre o jogo Space Racer">Ver
              Detalhes</a>
          </div>
        </article>
      </div>
    </section>
  </main>

  <%-include('rodape.ejs')%>

    <script src="script.js"></script>
    </body>

</html>