<!DOCTYPE html>
<html lang="pt-BR">
<%-include('cabecalho.ejs')%>

  <main id="main-content" role="main">
    <h1>Catálogo de Jogos</h1>
    <p>Consulte a lista completa de jogos cadastrados na plataforma.</p>

    <div class="search-bar" role="search">
      <input type="text" id="filter-text" placeholder="Filtrar por nome, gênero ou desenvolvedor..."
        aria-label="Filtrar jogos">
      <select id="filter-genre" aria-label="Filtrar por gênero">
        <option value="">Todos os Gêneros</option>
        <option value="RPG">RPG</option>
        <option value="Aventura">Aventura</option>
        <option value="Corrida">Corrida</option>
        <option value="Estratégia">Estratégia</option>
      </select>
      <button type="button" id="btn-filter">Aplicar Filtros</button>
    </div>


    <div class="game-grid" id="catalog-grid">
      <article class="game-card">
        <%for (const {id, imagem, nome, genero, desenvolvedor, anoLancamento, tempoMedio, status, nota} of jogos) {%>
          <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=500&q=80"
            alt="Cena futurista em estilo cyberpunk do jogo Cyber Quest">
          <div class="game-card-content">
            <h3>
              <%=nome%>
            </h3>
            <p><strong>Gênero:</strong> RPG</p>
            <p><strong>Desenvolvedor:</strong> Pixel Studio (Indie)</p>
            <p><strong>Ano de Lançamento:</strong> 2023</p>
            <p><strong>Tempo Médio:</strong> 45 horas</p>
            <p><strong>Status:</strong> <span class="badge badge-active">Ativo</span></p>
            <p class="rating">★ Nota: 8.9 / 10</p>
            <a href="/jogo/:id" class="card-link" aria-label="Ver mais detalhes sobre Cyber Quest">Ver
              Detalhes</a>
          </div>
          <%}%>
      </article>
    </div>
  </main>

  <%-include('rodape.ejs')%>

    <script src="script.js"></script>
    </body>

</html>